# Cases whose golden comes from a fork commit, one name per line, each with
# the change of behaviour it judges. Every case in cases.list not named here
# judges behaviour the fork preserves, and its golden comes from upstream
# v4.8.0. make-golden.sh writes one set or the other, chosen by REF.
#
# ADR-102 step 1 (aaronsb/kmscon): colon sub-parameters, underline styles,
# underline colour (SGR 58/59) and strike-through (SGR 9/29).
sgr-basic                   # SGR 9 sets strike
sgr-underline-extended      # 4:x styles and 58 colours apply; 4;58;5;196 no longer blinks
# Added with the change; upstream discards or misreads each:
sgr-color-forms-fg          # colon colour forms for 38
sgr-color-forms-bg          # colon colour forms for 48
sgr-color-forms-ul          # SGR 58 in every colour form
sgr-underline-styles        # 4:0-4:5, unknown style, 21, 24
sgr-strike                  # 9 and 29
sgr-underline-color-reset   # 59, 24 and SGR 0 against the underline colour
sgr-subparam-unknown        # unknown sub-parameters skipped alone
sgr-58-semicolon-no-blink   # 58 consumes its 5
sgr-subparam-overflow       # sub-parameters past eight dropped
sgr-color-colon-out-of-range  # colon index or component above 255 rejected
sgr-color-semicolon-subparams # semicolon form with sub-parameters consumes nothing
#
# ADR-102 step 3: grapheme clusters, width methods, mode 2027.
combining                   # combining marks join their base cell
emoji                       # one cell per emoji sequence; VS16 widens the heart
# Added with step 3:
emoji-sequences             # ZWJ family, flag, keycap, skin tone: one cell each
vs16-widen                  # VS16 widens a placed cell
vs16-margin                 # VS16 in the last column moves the cluster down
vs16-unlisted-base          # VS16 on an unlisted base changes nothing
vs15-width                  # VS15 never changes width
width-methods               # unicode and wcwidth on the same text
mode-2027-decrqm            # DECRQM replies for mode 2027
mode-2027-resets            # RIS and DECSTR return to the configured method
mode-2026                   # mode 2026 (ADR-201 step 3): DECRQM in and out of a frame, the ends, the host setting off
combining-after-move        # a mark after cursor movement joins the cell before it
cluster-reuse-erase         # clusters erased and printed again
cluster-max                 # a 33-codepoint cluster keeps 32
prepend-width               # a Prepend mark starts a cluster with width
vs16-insert-mode            # VS16 widening in insert mode shifts the line
insert-wide-one-column      # insert mode with wide cells on a one-column screen
colour-resolve              # colours, dim and reverse with underline colours (ADR-102 step 2)
wide-chars                  # a wide character with one column left wraps; it is not cut at the margin
prog-tmux                   # cells tmux's status line erases take its background colour only, not its foreground; DECRQM answers its 2026 query; XTVERSION answers its CSI > q (#23)
#
# ADR-103 step 3c: sixel is on in tsm-replay, so DA1 carries attribute 4,
# and XTWINOPS 14 and 16 are answered:
replies-da1                 # DA1 replies ?60;1;4;6;9;15c
#
# Upstream fixes after v4.8.0, merged from kmscon/libtsm:
prog-vim                    # vim's XTQMODKEYS query (CSI ? 4 m) is not SGR 4: its status line is not underlined (upstream c0733a5); it is answered CSI > 4;2 m, the level vim set (#25)
#
# ADR-103 step 3a: image placements, which upstream has no view of. Each
# case judges one row of the screen-event table for a sixel and a kitty
# placement:
img-print           # text over a sixel removes the cells it covers; a kitty placement stays
img-sixel-over      # an opaque sixel removes older sixels under it; a transparent one does not
img-el0             # EL 0 removes the sixel cells it erases; kitty untouched
img-el1             # EL 1, as EL 0
img-el2             # EL 2, as EL 0
img-ech             # ECH splits a sixel around the erased cell; kitty untouched
img-ed0             # ED 0 removes the sixel cells it erases; kitty untouched
img-ed1             # ED 1, as ED 0
img-decsed          # DECSED, as ED 0 (the parser sets no protected cells)
img-decsel          # DECSEL, as EL 2
img-ich             # ICH removes a sixel's row from the cursor on; kitty untouched
img-dch             # DCH, as ICH
img-ed2             # ED 2 removes kitty placements on the screen and sixels' screen parts
img-ed3             # ED 3 drops placements anchored in scrollback
img-scroll-up       # LF, IND and SU carry placements into scrollback whole
img-scroll-up-bottom  # rows past the screen's bottom move up with their lines
img-scroll-down     # SD and RI move placements down, clipped at the bottom
img-scroll-down-sb  # SD splits a sixel at the screen's top; a kitty placement across it stays
img-region          # a region scroll splits sixels at its edges; kitty moves only wholly inside
img-il              # IL scrolls placements down from the cursor's line
img-dl              # DL scrolls placements up from the cursor's line
img-discard-sb      # a line discarded from full scrollback clips its placements by a row
img-discard-alt     # the alternate screen's discarded top line clips its placements
img-resize          # lines back from scrollback carry their placements
img-resize-shrink   # lines sent to scrollback by a resize carry theirs
img-alt-1049        # the alternate store empties; the main screen's placements show again
img-alt-47          # 47 keeps the alternate text but not its images
img-alt-1047        # 1047, as 1049
img-alt-shown       # on the alternate screen only its placements show
img-ris             # RIS empties both stores
img-decstr          # DECSTR leaves placements
#
# ADR-103 step 3c: sixel strings through the vte, which upstream ignores.
six-cursor-xterm        # cursor after sixel, as in a run of xterm 411 (two departures, ADR-103)
six-cursor              # cursor on the picture's last row, at its left column
six-cursor-8452         # mode 8452: cursor right of the picture, clamped
six-scroll-bottom       # a picture past the bottom scrolls as index does
six-scroll-region       # a picture scrolled into a region whole; a taller one cut
six-decsdm              # DECSDM set: top left, cut to the screen, cursor unmoved
six-colours             # RGB and HLS registers, repeats, $ and -
six-raster              # raster attributes size the picture; P2; no aspect scaling
six-registers           # mode 1070: private or shared registers
six-registers-ris       # RIS empties the shared registers, sets 1070 again
six-max-size            # max-graphic-size bounds the picture
six-cancel              # CAN and SUB discard; ESC shows; other DCS ignored
six-text                # text cuts a sixel; a transparent sixel keeps text
six-scrollback          # a picture into scrollback with its lines and back
six-clear               # ED 2 and ED 3 remove pictures on screen and in scrollback
six-replies             # DA1 attribute 4, XTSMGRAPHICS, XTWINOPS 14, 16, 18
six-off                 # no budget: sixel ignored, no attribute 4
six-img2sixel-palette16 # img2sixel stream: 16 colours
six-img2sixel-gradient  # img2sixel stream: a gradient
six-img2sixel-highcolor # img2sixel stream: registers redefined band by band
#
# ADR-103 step 4a: the kitty graphics protocol, which upstream ignores.
apc-kitty-graphics  # the a=T pixel is placed at the cursor, which moves past it
kit-transmit        # a=T with f=32 and f=24, anonymous, a=t then a=p; replies and cursor
kit-chunked         # chunked direct data, placed where the last chunk finds the cursor
kit-chunk-large     # a chunk of 131072 characters (icat's size) streams whole into the image sent
kit-chunk-abort     # a delete, another command and CAN abort an upload
kit-ids             # I picks the lowest free id; i with I refused; ENOENT
kit-replace         # an id sent again replaces its image and placements; p moves one
kit-replace-refused # a replacement refused with ENOSPC keeps the old image (libtsm#37)
kit-place-size      # c and r, source rectangles, offsets, an offset outside the cell
kit-bands           # z chooses the band; at one z the lower id first
kit-cursor          # C=1; the cursor past the box, at the bottom, the right edge, a region
kit-delete-a        # d=a and d=A
kit-delete-i        # d=i and d=I, with and without p
kit-delete-n        # d=n and d=N
kit-delete-c        # d=c and d=C
kit-delete-p        # d=p and d=P
kit-delete-q        # d=q and d=Q
kit-delete-r        # d=r and d=R
kit-delete-x        # d=x and d=X
kit-delete-y        # d=y and d=Y
kit-delete-z        # d=z and d=Z
kit-delete-f        # d=f and d=F delete nothing
kit-delete-sb       # a on the screen only, I in scrollback too, sixels untouched
kit-replies         # q=0, 1 and 2; no reply without i or I
kit-query           # a=q checks without storing or replacing
kit-query-number    # a=q without i: no reply under any q, nothing stored
kit-refused         # EINVAL and EBADF refusals with no host; keys past 1 KiB ignored
kit-cancel          # CAN and SUB abort a command
kit-evict           # unplaced, scrollback, then kitty on screen; a sixel never; ENOSPC
kit-evict-stamp     # an old image placed again keeps its transmission stamp
kit-ed2             # ED 2 keeps the image; leaving the alternate screen and RIS empty stores
kit-host-media      # each medium reaches the host; inline raw data stays in libtsm
kit-host-names      # names too long or holding NUL refused; a name escaped
kit-host-mpv        # mpv's whole t=s commands with m=1, each a request (ADR-105)
kit-host-icat       # kitten icat's detection: three OKs before DA1 (ADR-106)
kit-host-icat-gif   # icat's a=a refused; its a=f over t=s handed over as a discard
kit-host-pause      # a put after a file transmission parsed after the reply, in order
kit-host-errors     # the host's outcomes, a=q, size checks, ENOSPC from either reservation
kit-host-requests   # the request each command row of What libtsm asks for produces
kit-host-outcomes   # the reply each outcome produces, per column of What libtsm answers
kit-host-lengths    # kitty's S and length rules (ADR-107) through the fixture host
kit-host-media-nohook # kit-host-media with the host removed
kit-host-names-nohook # kit-host-names with the host removed
kit-host-mpv-nohook # kit-host-mpv with the host removed
kit-host-icat-nohook # kit-host-icat with the host removed
kit-host-icat-gif-nohook # kit-host-icat-gif with the host removed
kit-host-pause-nohook # kit-host-pause with the host removed
kit-host-errors-nohook # kit-host-errors with the host removed
kit-host-requests-nohook # kit-host-requests with the host removed
kit-host-outcomes-nohook # kit-host-outcomes with the host removed
kit-host-lengths-nohook # kit-host-lengths with the host removed
